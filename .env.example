# Local tests generate ephemeral client secrets. Never commit a real credential.
TEST_ENV=local
# PORT=4180
# BASE_URL=http://127.0.0.1:4180

# For compatible staging environments only:
# TEST_ENV=staging
# BASE_URL=https://api.staging.example.test
# QA_CUSTOMER_CLIENT_ID=
# QA_CUSTOMER_CLIENT_SECRET=
# QA_ADJUSTER_CLIENT_ID=
# QA_ADJUSTER_CLIENT_SECRET=
